{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Eye-Eye-Tee",
    "description": "Ecommerce for Designers",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "basePath": "/",
  "schemes": ["http", "https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints related to user authentication"
    },

    {
      "name": "Product Management",
      "description": "Endpoints for managing products"
    },
    {
      "name": "Misc",
      "description": "Misc Endpoints"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Misc"],
        "summary": "Application service health check 💗",
        "produces": ["application/json"],
        "consumes": ["application/json"],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Google auth strategy, creates a new user in db if no user exists, else logs the user in",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/user/data": {
      "get": {
        "tags": ["Authentication"],
        "summary": "API to fetch user data from the server after successful authentication",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK user data fetched"
          },
          "401": {
            "description": "Access forbidden. Not logged in or Incorrect x-api-key!",
            "error": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/user/create": {
      "post": {
        "tags": ["Authentication"],
        "description": "Create user without oauth , random password is generated and mail is sent",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create a new user",
            "schema": {
              "$ref": "#/definitions/UserInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "User has been created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK User already exists"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/user/login": {
      "post": {
        "tags": ["Authentication"],
        "description": "Login user manually without oauth",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create a new user",
            "schema": {
              "$ref": "#/definitions/UserLoginInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "User has been Logged In",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK Invalid Credentials"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/product/create": {
      "post": {
        "tags": ["Product Management"],
        "description": "adding a new product to the inventory",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create a new product",
            "schema": {
              "$ref": "#/definitions/ProductInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Product added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK Invalid Credentials"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/product/read/{id}": {
      "get": {
        "tags": ["Product Management"],
        "summary": "API to fetch product data from the server, requires a product ID in the URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Product ID"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "default": "token",
            "schema": {
              "type": "string"
            },
            "description": "API Key for authentication"
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Product data fetched"
          },
          "401": {
            "description": "Access forbidden - Not logged in or Incorrect x-api-key!",
            "content": {
              "application/json": {
                "example": {
                  "message": "Access forbidden"
                }
              }
            }
          },
          "501": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/api/product/changeQuantity": {
      "post": {
        "tags": ["Product Management"],
        "description": "Change the quantity of a product",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to change the quantity of a product",
            "schema": {
              "$ref": "#/definitions/ChangeQuantityInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Product quantity changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/product/addColor": {
      "post": {
        "tags": ["Product Management"],
        "description": "Add a color to a product",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to add a color to a product",
            "schema": {
              "$ref": "#/definitions/AddColorInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Color added to the product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "404": {
            "description": "Product not found",
            "error": {}
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/product/deleteColor": {
      "post": {
        "tags": ["Product Management"],
        "description": "Delete a color from a product",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to delete a color from a product",
            "schema": {
              "$ref": "#/definitions/DeleteColorInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "Color deleted from the product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "404": {
            "description": "Product not found",
            "error": {}
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    }
  },
  "definitions": {
    "Input": {
      "required": ["input"],
      "properties": {
        "input": {
          "type": "object",
          "$ref": "#/definitions/InputBody"
        }
      }
    },
    "UserInput": {
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string",
          "default": "John Doe"
        },
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        }
      }
    },
    "UserLoginInput": {
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        },
        "password": {
          "type": "string",
          "default": "john@11$"
        }
      }
    },
    "ProductInput": {
      "required": ["name", "quantity", "color", "category"],
      "properties": {
        "name": {
          "type": "string",
          "default": "eye-eye-tee"
        },
        "quantity": {
          "type": "number",
          "default": "100"
        },
        "color": {
          "type": "color",
          "default": "red",
          "$ref": "#/components/schemas/ColorEnum"
        },
        "category": {
          "type": "category",
          "default": "Tshirt",
          "$ref": "#/components/schemas/CategoryEnum"
        }
      }
    },
    "ChangeQuantityInput": {
      "required": ["productId", "quantity"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "quantity": {
          "type": "number",
          "description": "New quantity"
        }
      }
    },
    "AddColorInput": {
      "required": ["productId", "color"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "color": {
          "type": "string",
          "description": "Color to add"
        }
      }
    },
    "DeleteColorInput": {
      "required": ["productId", "color"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "color": {
          "type": "string",
          "description": "Color to delete"
        }
      }
    },
    "ResponseWithMessage": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "x-api-key": {
      "type": "apiKey",
      "name": "x-api-key",
      "in": "header"
    }
  },
  "components": {
    "schemas": {
      "ColorEnum": {
        "type": "string",
        "enum": ["red", "black", "white", "yellow"]
      },
      "CategoryEnum": {
        "type": "string",
        "enum": ["shirt", "Tshirt", "Cup"]
      }
    }
  }
}
