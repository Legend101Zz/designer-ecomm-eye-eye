{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Eye-Eye-Tee",
    "description": "Ecommerce for Designers",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "basePath": "/",
  "schemes": ["http", "https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["healthcheck"],
        "summary": "Application service health check 💗",
        "produces": ["application/json"],
        "consumes": ["application/json"],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/auth/google": {
      "get": {
        "tags": ["Google SignIn/SignUp"],
        "summary": "Google auth strategy ,creates a new user in db if no user exists , else logs the user in  ",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/user/data": {
      "get": {
        "tags": ["User data after auth"],
        "summary": "Api to fetch user data from server after successful authentication  ",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK  user data fetched"
          },

          "401": {
            "description": "Access forbidden. Not logged in or Incorrect x-api-key!",
            "error": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/user/create": {
      "post": {
        "tags": ["create user manually without oauth"],
        "description": "Create user",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create new user",
            "schema": {
              "$ref": "#/definitions/UserInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "User has been created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK User already exists"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/user/login": {
      "post": {
        "tags": ["login user manually without oauth"],
        "description": "Login user",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create new user",
            "schema": {
              "$ref": "#/definitions/UserLoginInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "User has been Logged In",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK Invalid Credentials"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    },
    "/api/product/create": {
      "post": {
        "tags": ["adding a new product to the inventory"],
        "description": "Login user",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "default": "Provide API-key (ie. API_KEY_TOKEN from .env.locals file)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Input",
            "in": "body",
            "description": "Input data required to create new user",
            "schema": {
              "$ref": "#/definitions/ProductInput"
            }
          }
        ],
        "produces": ["application/json"],
        "responses": {
          "200": {
            "description": "product added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/definitions/ResponseWithMessage"
                }
              }
            }
          },
          "401": {
            "description": "Access forbidden. Incorrect x-api-key!",
            "error": {}
          },
          "201": {
            "description": "OK Invalid Credentials"
          },
          "500": {
            "description": "Internal Server Error",
            "message": {}
          }
        },
        "security": [
          {
            "api_key": "$X_API_KEY"
          }
        ]
      }
    }
  },

  "definitions": {
    "Input": {
      "required": ["input"],
      "properties": {
        "input": {
          "type": "object",
          "$ref": "#/definitions/InputBody"
        }
      }
    },
    "UserInput": {
      "required": ["name", "email", "password"],
      "properties": {
        "name": {
          "type": "string",
          "default": "John Doe"
        },
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        },
        "password": {
          "type": "string",
          "default": "john@11$"
        }
      }
    },
    "UserLoginInput": {
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        },
        "password": {
          "type": "string",
          "default": "john@11$"
        }
      }
    },
    "ProductInput": {
      "required": ["name", "quantity", "color", "category"],
      "properties": {
        "name": {
          "type": "string",
          "default": "eye-eye-tee"
        },
        "quantity": {
          "type": "number",
          "default": "100"
        },
        "color": {
          "type": "color",
          "default": "red",
          "$ref": "#/components/schemas/ColorEnum"
        },
        "category": {
          "type": "category",
          "default": "Tshirt",
          "$ref": "#/components/schemas/CategoryEnum"
        }
      }
    },
    "ResponseWithMessage": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "x-api-key": {
      "type": "apiKey",
      "name": "x-api-key",
      "in": "header"
    }
  },
  "components": {
    "schemas": {
      "ColorEnum": {
        "type": "string",
        "enum": ["red", "black", "white", "yellow"]
      },
      "CategoryEnum": {
        "type": "string",
        "enum": ["shirt", "Tshirt", "Cup"]
      }
    }
  }
}
