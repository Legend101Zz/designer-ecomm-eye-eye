  "definitions": {
    "Input": {
      "required": ["input"],
      "properties": {
        "input": {
          "type": "object",
          "$ref": "#/definitions/InputBody"
        }
      }
    },
    "AddToCartInput": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "quantity": {
          "type": "number",
          "description": "Quantity to add to the cart"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        }
      }
    },
    "ChangeCartQuantityInput": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "quantity": {
          "type": "number",
          "description": "New quantity in the cart"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        }
      }
    },
    "RemoveFromCartInput": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "userId": {
          "type": "string",
          "description": "User ID"
        }
      }
    },
    "UserInput": {
      "required": ["name", "email"],
      "properties": {
        "name": {
          "type": "string",
          "default": "John Doe"
        },
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        }
      }
    },
    "UserLoginInput": {
      "required": ["email", "password"],
      "properties": {
        "email": {
          "type": "string",
          "default": "john.d@example.net"
        },
        "password": {
          "type": "string",
          "default": "john@11$"
        }
      }
    },
    "ProductInput": {
      "required": ["name", "quantity", "color", "category"],
      "properties": {
        "name": {
          "type": "string",
          "default": "eye-eye-tee"
        },
        "quantity": {
          "type": "number",
          "default": "100"
        },
        "color": {
          "type": "color",
          "default": "red",
          "$ref": "#/components/schemas/ColorEnum"
        },
        "category": {
          "type": "category",
          "default": "Tshirt",
          "$ref": "#/components/schemas/CategoryEnum"
        }
      }
    },
    "ChangeQuantityInput": {
      "required": ["productId", "quantity"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "quantity": {
          "type": "number",
          "description": "New quantity"
        }
      }
    },
    "AddColorInput": {
      "required": ["productId", "color"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "color": {
          "type": "string",
          "description": "Color to add"
        }
      }
    },
    "DeleteColorInput": {
      "required": ["productId", "color"],
      "properties": {
        "productId": {
          "type": "string",
          "description": "Product ID"
        },
        "color": {
          "type": "string",
          "description": "Color to delete"
        }
      }
    },
    "designerProfile": {
      "required": ["designerId"],
      "properties": {
        "designerId": {
          "type": "string",
          "description": "Product ID"
        },
        "legal_first_name": {
          "type": "string",
          "description": " legal_first_name"
        },
        "legal_last_name": {
          "type": "string",
          "description": "legal_last_name"
        },
        "description": {
          "type": "string",
          "description": "legal_last_name"
        },
        "socialMedia": {
          "type": "string",
          "description": "socialMedia links"
        },
        "legal_address": {
          "type": "string",
          "description": "legal_address"
        },
        "portfolioLinks": {
          "type": "string",
          "description": "portfolioLinks"
        }
      }
    },
    "productImages": {
      "required": ["productId", "image"],
      "properties": {
        "productId": {
          "type": "string",
