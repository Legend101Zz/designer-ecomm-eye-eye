{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Deauth API",
    "description": "API documentation for Deauth Backend services"
  },
  "host": "localhost:8080",
  "basePath": "/api",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "ApiKeyAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key"
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Admin",
      "description": "Admin management endpoints"
    },
    {
      "name": "User",
      "description": "User management endpoints"
    },
    {
      "name": "Designer",
      "description": "Designer management endpoints"
    },
    {
      "name": "Design",
      "description": "Design management endpoints"
    },
    {
      "name": "Product",
      "description": "Product management endpoints"
    },
    {
      "name": "Final Product",
      "description": "Final product management endpoints"
    },
    {
      "name": "Authentication",
      "description": "Authentication endpoints"
    }
  ],
  "paths": {
    "/admin/create": {
      "post": {
        "tags": ["Admin"],
        "summary": "Create new admin",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "format": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Admin created successfully"
          },
          "400": {
            "description": "Admin with this email already exists"
          }
        }
      }
    },
    "/admin/login": {
      "post": {
        "tags": ["Admin"],
        "summary": "Admin login",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "format": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin logged in successfully"
          },
          "401": {
            "description": "Incorrect password"
          },
          "404": {
            "description": "Admin not found"
          }
        }
      }
    },
    "/admin/products": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get all products",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "type": "string",
            "description": "Search by product name"
          },
          {
            "in": "query",
            "name": "category",
            "type": "string",
            "description": "Filter by category"
          }
        ],
        "responses": {
          "200": {
            "description": "Products retrieved successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/admin/add-product": {
      "post": {
        "tags": ["Admin"],
        "summary": "Add a new product",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "formData",
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "quantity",
            "type": "integer",
            "required": true
          },
          {
            "in": "formData",
            "name": "category",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "color",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "image",
            "type": "file",
            "required": true,
            "description": "Product image"
          }
        ],
        "responses": {
          "200": {
            "description": "Product added successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/admin/designer": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get all designers",
        "responses": {
          "200": {
            "description": "Designers retrieved successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/designer/request": {
      "post": {
        "tags": ["Designer"],
        "summary": "Request to become a designer",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "formData",
            "name": "userId",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "fullname",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "artistName",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "description",
            "type": "string"
          },
          {
            "in": "formData",
            "name": "portfolioLinks",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "in": "formData",
            "name": "image",
            "type": "file",
            "required": true,
            "description": "Profile and cover photos"
          }
        ],
        "responses": {
          "200": {
            "description": "Designer request submitted successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/designer/createDesign": {
      "post": {
        "tags": ["Designer"],
        "summary": "Create a new design",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "formData",
            "name": "designerId",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "title",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "description",
            "type": "string"
          },
          {
            "in": "formData",
            "name": "image",
            "type": "file",
            "required": true,
            "description": "Design image"
          }
        ],
        "responses": {
          "201": {
            "description": "Design created successfully"
          },
          "404": {
            "description": "Designer not found or not approved"
          }
        }
      }
    },
    "/designs/show": {
      "get": {
        "tags": ["Design"],
        "summary": "Get all designs",
        "responses": {
          "200": {
            "description": "Designs retrieved successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/finalproduct/create-final-products": {
      "post": {
        "tags": ["Final Product"],
        "summary": "Create final products",
        "consumes": ["multipart/form-data"],
        "parameters": [
          {
            "in": "formData",
            "name": "productId",
            "type": "string",
            "required": true
          },
          {
            "in": "formData",
            "name": "designApplications",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "designImageUrl": {
                  "type": "string"
                },
                "position": {
                  "type": "string",
                  "enum": ["front", "back"]
                }
              }
            }
          },
          {
            "in": "formData",
            "name": "image",
            "type": "file",
            "required": true,
            "description": "Product images with applied designs"
          }
        ],
        "responses": {
          "201": {
            "description": "Final product created successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user/create": {
      "post": {
        "tags": ["User"],
        "summary": "Create new user",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["username", "email"],
              "properties": {
                "username": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "User login",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "format": "password"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "201": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/google": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Google OAuth login",
        "responses": {
          "302": {
            "description": "Redirect to Google authentication"
          }
        }
      }
    },
    "/user/cart/{userId}": {
      "get": {
        "tags": ["User"],
        "summary": "Get user's cart",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Cart retrieved successfully"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "isDesigner": {
          "type": "boolean"
        }
      }
    },
    "Designer": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "fullname": {
          "type": "string"
        },
        "artistName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isApproved": {
          "type": "boolean"
        }
      }
    }
  }
}
